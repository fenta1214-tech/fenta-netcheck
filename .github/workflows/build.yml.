name: Build Fenta NetCheck APK

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Unpack Android project
        run: unzip -q FentaNetCheck_WebView_Project.zip -d unpacked

      - name: Build debug APK
        working-directory: unpacked/FentaNetCheckWebView
        run: gradle assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: FentaNetCheck-APK
          path: unpacked/FentaNetCheckWebView/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
